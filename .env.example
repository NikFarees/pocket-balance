# PocketBalance environment variables
# Copy to `.env.local` and fill in real values. NEVER commit `.env.local`.

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL used for auth email redirects (e.g. https://yourdomain.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI assistant (required for the assistant feature) ---
# Server-only. Get a free key at aistudio.google.com. NEVER prefix with NEXT_PUBLIC.
GOOGLE_AI_STUDIO_API_KEY=
# Optional; defaults to gemini-2.0-flash
GOOGLE_AI_MODEL=gemini-2.0-flash

# --- Rate limiting (optional but recommended for production) ---
# Upstash Redis credentials for the AI assistant rate limiter.
# If unset, the limiter no-ops (allows all requests). Create a free DB at upstash.com.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- CAPTCHA (optional; for Cloudflare Turnstile on auth forms) ---
# Public site key for the Turnstile widget. The matching secret goes in the
# Supabase dashboard (Auth -> Settings -> CAPTCHA), not here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
